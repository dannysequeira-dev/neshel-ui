{
  "name": "@neshel-ui/animations",
  "version": "0.0.0",
  "private": true,
  "description": "Modular, accessible motion primitives and effects for Neshel-UI (experimental, unpublished)",
  "keywords": [
    "neshel-ui",
    "design-system",
    "react",
    "animation",
    "motion",
    "tilt",
    "entrance",
    "hover",
    "press",
    "scroll",
    "parallax",
    "reduced-motion",
    "gestures",
    "drag",
    "pinch-zoom",
    "flip",
    "layout-animation",
    "presence",
    "cinematic",
    "timeline",
    "scenes",
    "camera",
    "storyboard",
    "view-transitions",
    "page-transitions",
    "router"
  ],
  "homepage": "https://github.com/dannysequeira-dev/neshel-ui/tree/main/packages/animations#readme",
  "bugs": {
    "url": "https://github.com/dannysequeira-dev/neshel-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysequeira-dev/neshel-ui.git",
    "directory": "packages/animations"
  },
  "author": "Neshel-UI maintainers",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./entrance": {
      "types": "./dist/entrance/index.d.ts",
      "import": "./dist/entrance/index.js"
    },
    "./hover": {
      "types": "./dist/hover/index.d.ts",
      "import": "./dist/hover/index.js"
    },
    "./press": {
      "types": "./dist/press/index.d.ts",
      "import": "./dist/press/index.js"
    },
    "./scroll": {
      "types": "./dist/scroll/index.d.ts",
      "import": "./dist/scroll/index.js"
    },
    "./gestures": {
      "types": "./dist/gestures/index.d.ts",
      "import": "./dist/gestures/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./cinematic": {
      "types": "./dist/cinematic/index.d.ts",
      "import": "./dist/cinematic/index.js"
    },
    "./page-transitions": {
      "types": "./dist/page-transitions/index.d.ts",
      "import": "./dist/page-transitions/index.js"
    },
    "./page-transitions/next": {
      "types": "./dist/page-transitions/next.d.ts",
      "import": "./dist/page-transitions/next.js"
    },
    "./page-transitions/react-router": {
      "types": "./dist/page-transitions/react-router.d.ts",
      "import": "./dist/page-transitions/react-router.js"
    },
    "./styles.css": "./dist/styles.css",
    "./hover.css": "./dist/hover.css",
    "./press.css": "./dist/press.css",
    "./scroll.css": "./dist/scroll.css",
    "./gestures.css": "./dist/gestures.css",
    "./layout.css": "./dist/layout.css",
    "./cinematic.css": "./dist/cinematic.css",
    "./page-transitions.css": "./dist/page-transitions.css",
    "./page-transitions-mpa.css": "./dist/page-transitions-mpa.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs src/hover/hover.css dist/hover.css src/press/press.css dist/press.css src/scroll/scroll.css dist/scroll.css src/gestures/gestures.css dist/gestures.css src/layout/layout.css dist/layout.css src/cinematic/cinematic.css dist/cinematic.css src/page-transitions/page-transitions.css dist/page-transitions.css && node ../../scripts/copy-css.mjs --concat dist/styles.css src/styles.css src/hover/hover.css src/press/press.css src/scroll/scroll.css && node ../../scripts/copy-css.mjs --concat dist/page-transitions-mpa.css src/page-transitions/mpa.css src/page-transitions/page-transitions.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "16.4.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "8.5.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "next": ">=16.4.0",
    "react-router": ">=8.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  }
}
