{
  "name": "@neshel-ui/animations",
  "version": "0.0.0",
  "private": true,
  "description": "Modular, accessible motion primitives and effects for Neshel-UI (experimental, unpublished)",
  "keywords": [
    "neshel-ui",
    "design-system",
    "react",
    "animation",
    "motion",
    "tilt",
    "entrance",
    "hover",
    "press",
    "scroll",
    "parallax",
    "reduced-motion"
  ],
  "homepage": "https://github.com/dannysequeira-dev/neshel-ui/tree/main/packages/animations#readme",
  "bugs": {
    "url": "https://github.com/dannysequeira-dev/neshel-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysequeira-dev/neshel-ui.git",
    "directory": "packages/animations"
  },
  "author": "Neshel-UI maintainers",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./entrance": {
      "types": "./dist/entrance/index.d.ts",
      "import": "./dist/entrance/index.js"
    },
    "./hover": {
      "types": "./dist/hover/index.d.ts",
      "import": "./dist/hover/index.js"
    },
    "./press": {
      "types": "./dist/press/index.d.ts",
      "import": "./dist/press/index.js"
    },
    "./scroll": {
      "types": "./dist/scroll/index.d.ts",
      "import": "./dist/scroll/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./hover.css": "./dist/hover.css",
    "./press.css": "./dist/press.css",
    "./scroll.css": "./dist/scroll.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs src/hover/hover.css dist/hover.css src/press/press.css dist/press.css src/scroll/scroll.css dist/scroll.css && node ../../scripts/copy-css.mjs --concat dist/styles.css src/styles.css src/hover/hover.css src/press/press.css src/scroll/scroll.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:"
  }
}
