{
  "name": "@neshel-ui/cli",
  "version": "0.0.0",
  "description": "Configuration and CSS generation CLI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "neshel": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "colorjs.io": "~0.7.1",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@neshel-ui/config": "workspace:^"
  },
  "devDependencies": {
    "@neshel-ui/config": "workspace:^",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
