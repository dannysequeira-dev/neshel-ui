{
  "name": "@neshel-ui/cli",
  "version": "0.1.0",
  "description": "Configuration and CSS generation CLI",
  "keywords": [
    "neshel-ui",
    "design-system",
    "cli",
    "design-tokens",
    "theming",
    "css",
    "breakpoints",
    "capsize"
  ],
  "homepage": "https://github.com/dannysequeira-dev/neshel-ui/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/dannysequeira-dev/neshel-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysequeira-dev/neshel-ui.git",
    "directory": "packages/cli"
  },
  "author": "Neshel-UI maintainers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "neshel": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capsizecss/core": "^4.1.3",
    "colorjs.io": "~0.7.1",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@neshel-ui/config": "workspace:^"
  },
  "devDependencies": {
    "@capsizecss/metrics": "^4.4.0",
    "@neshel-ui/config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
