{
  "schema": 1,
  "package": "@neshel-ui/typography",
  "version": "0.0.0",
  "layer": "components.neshel",
  "rules": [
    {
      "selector": ".neshel-typography",
      "declarations": [
        [
          "margin",
          "0"
        ],
        [
          "--neshel-type-leading",
          "initial"
        ],
        [
          "--neshel-type-size-leading",
          "initial"
        ],
        [
          "line-height",
          "var(--neshel-type-leading, var(--neshel-type-size-leading))"
        ]
      ]
    },
    {
      "selector": ".neshel-text-family-body",
      "declarations": [
        [
          "font-family",
          "var(--neshel-font-body)"
        ],
        [
          "--neshel-type-scale",
          "var(--neshel-font-body-scale, 1)"
        ],
        [
          "--neshel-type-cap-trim",
          "var(--neshel-font-body-cap-trim, 0)"
        ],
        [
          "--neshel-type-baseline-trim",
          "var(--neshel-font-body-baseline-trim, 0)"
        ],
        [
          "--neshel-type-trim",
          "var(--neshel-font-body-trim, 0)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-family-display",
      "declarations": [
        [
          "font-family",
          "var(--neshel-font-display)"
        ],
        [
          "--neshel-type-scale",
          "var(--neshel-font-display-scale, 1)"
        ],
        [
          "--neshel-type-cap-trim",
          "var(--neshel-font-display-cap-trim, 0)"
        ],
        [
          "--neshel-type-baseline-trim",
          "var(--neshel-font-display-baseline-trim, 0)"
        ],
        [
          "--neshel-type-trim",
          "var(--neshel-font-display-trim, 0)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-family-mono",
      "declarations": [
        [
          "font-family",
          "var(--neshel-font-mono)"
        ],
        [
          "--neshel-type-scale",
          "var(--neshel-font-mono-scale, 1)"
        ],
        [
          "--neshel-type-cap-trim",
          "var(--neshel-font-mono-cap-trim, 0)"
        ],
        [
          "--neshel-type-baseline-trim",
          "var(--neshel-font-mono-baseline-trim, 0)"
        ],
        [
          "--neshel-type-trim",
          "var(--neshel-font-mono-trim, 0)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tone-default",
      "declarations": [
        [
          "color",
          "var(--neshel-foreground)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tone-muted",
      "declarations": [
        [
          "color",
          "var(--neshel-muted-foreground)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tone-primary",
      "declarations": [
        [
          "color",
          "var(--neshel-primary)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tone-destructive",
      "declarations": [
        [
          "color",
          "var(--neshel-destructive)"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tracking-tight",
      "declarations": [
        [
          "letter-spacing",
          "-0.025em"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tracking-normal",
      "declarations": [
        [
          "letter-spacing",
          "0"
        ]
      ]
    },
    {
      "selector": ".neshel-text-tracking-wide",
      "declarations": [
        [
          "letter-spacing",
          "0.025em"
        ]
      ]
    },
    {
      "selector": ".neshel-text-measure-narrow",
      "declarations": [
        [
          "max-inline-size",
          "45ch"
        ]
      ]
    },
    {
      "selector": ".neshel-text-measure-comfortable",
      "declarations": [
        [
          "max-inline-size",
          "65ch"
        ]
      ]
    },
    {
      "selector": ".neshel-text-measure-wide",
      "declarations": [
        [
          "max-inline-size",
          "80ch"
        ]
      ]
    },
    {
      "selector": ".neshel-text-measure-none",
      "declarations": [
        [
          "max-inline-size",
          "none"
        ]
      ]
    },
    {
      "selector": ".neshel-text-wrap-wrap",
      "declarations": [
        [
          "text-wrap",
          "wrap"
        ]
      ]
    },
    {
      "selector": ".neshel-text-wrap-nowrap",
      "declarations": [
        [
          "white-space",
          "nowrap"
        ]
      ]
    },
    {
      "selector": ".neshel-text-wrap-balance",
      "declarations": [
        [
          "text-wrap",
          "balance"
        ]
      ]
    },
    {
      "selector": ".neshel-text-wrap-pretty",
      "declarations": [
        [
          "text-wrap",
          "pretty"
        ]
      ]
    },
    {
      "selector": ".neshel-text-truncate",
      "declarations": [
        [
          "overflow",
          "hidden"
        ],
        [
          "text-overflow",
          "ellipsis"
        ],
        [
          "white-space",
          "nowrap"
        ]
      ]
    },
    {
      "selector": ".neshel-text-trim::before",
      "declarations": [
        [
          "content",
          "\"\""
        ],
        [
          "display",
          "table"
        ],
        [
          "margin-block-end",
          "calc((var(--neshel-type-cap-trim) + var(--neshel-type-leading, var(--neshel-type-size-leading)) / 2) * -1em * var(--neshel-type-trim))"
        ]
      ]
    },
    {
      "selector": ".neshel-text-trim::after",
      "declarations": [
        [
          "content",
          "\"\""
        ],
        [
          "display",
          "table"
        ],
        [
          "margin-block-start",
          "calc((var(--neshel-type-baseline-trim) + var(--neshel-type-leading, var(--neshel-type-size-leading)) / 2) * -1em * var(--neshel-type-trim))"
        ]
      ]
    }
  ],
  "responsive": [
    {
      "class": "text-size-xs",
      "declarations": [
        [
          "font-size",
          "calc(0.75rem * var(--neshel-type-scale, 1))"
        ],
        [
          "--neshel-type-size-leading",
          "1.5"
        ]
      ]
    },
    {
      "class": "text-size-sm",
      "declarations": [
        [
          "font-size",
          "calc(0.875rem * var(--neshel-type-scale, 1))"
        ],
        [
          "--neshel-type-size-leading",
          "1.5"
        ]
      ]
    },
    {
      "class": "text-size-base",
      "declarations": [
        [
          "font-size",
          "calc(1rem * var(--neshel-type-scale, 1))"
        ],
        [
          "--neshel-type-size-leading",
          "1.5"
        ]
      ]
    },
    {
      "class": "text-size-lg",
