{
  "name": "@neshel-ui/components",
  "version": "0.1.0",
  "description": "Accessible React components, navigation and application shell",
  "keywords": [
    "neshel-ui",
    "design-system",
    "react",
    "components",
    "accessibility",
    "dialog",
    "select",
    "app-shell"
  ],
  "homepage": "https://github.com/dannysequeira-dev/neshel-ui/tree/main/packages/components#readme",
  "bugs": {
    "url": "https://github.com/dannysequeira-dev/neshel-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysequeira-dev/neshel-ui.git",
    "directory": "packages/components"
  },
  "author": "Neshel-UI maintainers",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style-manifest.json": "./dist/style-manifest.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs src/styles.css dist/styles.css src/style-manifest.json dist/style-manifest.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@neshel-ui/config": "workspace:^",
    "typescript": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@neshel-ui/config": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@radix-ui/react-alert-dialog": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-navigation-menu": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "tailwind-variants": "catalog:"
  }
}
