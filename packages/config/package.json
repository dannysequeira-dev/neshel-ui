{
  "name": "@neshel-ui/config",
  "version": "0.0.0",
  "description": "CSS-first design tokens and typed theme configuration",
  "keywords": [
    "neshel-ui",
    "design-system",
    "design-tokens",
    "theming",
    "css-variables",
    "tailwindcss",
    "dark-mode"
  ],
  "homepage": "https://github.com/dannysequeira-dev/neshel-ui/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/dannysequeira-dev/neshel-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannysequeira-dev/neshel-ui.git",
    "directory": "packages/config"
  },
  "author": "Neshel-UI maintainers",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs src/tokens.css dist/tokens.css src/tailwind.css dist/tailwind.css src/tailwind.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
