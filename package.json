{
  "name": "neshel-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Neshel-UI - a modular, accessible and themeable React design system",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:storybook": "pnpm build:packages && pnpm --filter @neshel-ui/storybook dev",
    "dev:playground": "pnpm build:packages && pnpm --filter @neshel-ui/playground-vite dev",
    "build": "pnpm build:packages",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:playground": "pnpm build:packages && pnpm --filter @neshel-ui/playground-vite build",
    "build:storybook": "pnpm build:packages && pnpm --filter @neshel-ui/storybook build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check": "pnpm check:workspace && pnpm lint && pnpm typecheck && pnpm test && pnpm build:packages && pnpm check:exports",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  }
}
