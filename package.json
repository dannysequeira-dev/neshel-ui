{
  "name": "neshel-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Neshel-UI - a modular, accessible and themeable React design system",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:storybook": "pnpm build:packages && pnpm --filter @neshel-ui/storybook dev",
    "dev:playground": "pnpm build:packages && pnpm --filter @neshel-ui/playground-vite dev",
    "build": "pnpm build:packages",
    "build:packages": "node scripts/clean.mjs --packages && pnpm --filter \"./packages/**\" -r build",
    "build:playground": "pnpm build:packages && pnpm --filter @neshel-ui/playground-vite build",
    "build:storybook": "pnpm build:packages && pnpm --filter @neshel-ui/storybook build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:packages": "node --test \"packages/*/test/**/*.test.mjs\"",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:browser:components": "node scripts/check-components-browser.mjs",
    "generate:tokens": "node scripts/generate-default-css.mjs",
    "check": "pnpm run doctor && pnpm lint && pnpm typecheck && pnpm test && pnpm build:packages && pnpm test:packages && pnpm check:exports && pnpm check:pack --no-build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/check-platform.mjs && node scripts/check-workspace.mjs && node scripts/check-portability.mjs",
    "check:portability": "node scripts/check-portability.mjs",
    "spec-kit:init": "node scripts/bootstrap-spec-kit.mjs",
    "generate:component-css": "node scripts/generate-component-css.mjs",
    "docs:dev": "pnpm build:packages && pnpm --filter @neshel-ui/docs dev",
    "docs:build": "pnpm --filter @neshel-ui/docs build",
    "docs:preview": "node scripts/docs/serve.mjs apps/docs/out",
    "docs:api": "node scripts/docs/extract-api.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:starters": "node scripts/check-starters.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "check:next": "node scripts/check-next.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
