{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/storybook-static",
      "!**/coverage",
      "!packages/config/src/tokens.css",
      "!packages/config/src/tailwind.css",
      "!packages/layout/src/styles.css",
      "!packages/layout/src/style-manifest.json",
      "!packages/typography/src/styles.css",
      "!packages/typography/src/style-manifest.json",
      "!packages/components/src/styles.css",
      "!packages/components/src/style-manifest.json",
      "!**/neshel.generated.d.ts",
      "!packages/cli/test/fixtures",
      "!**/neshel.generated.css",
      "!.claude/skills/speckit-*",
      "!.specify/templates",
      "!.specify/scripts",
      "!.specify/workflows",
      "!.specify/integrations",
      "!.specify/init-options.json",
      "!.specify/integration.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
